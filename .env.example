# --- Operator (server only; never commit real values) ---
# Required for deploy scripts and any operator-signed writes.
# Generate with: yarn hardhat:account:generate
HEDERA_OPERATOR_ACCOUNT_ID=
HEDERA_OPERATOR_PRIVATE_KEY=



# Accepted aliases (create-scaffold-hbar / other templates):
# ACCOUNT_ID=
# PRIVATE_KEY=
# __RUNTIME_DEPLOYER_PRIVATE_KEY=

# --- Network / relays ---
# Default: testnet. Allowed: testnet | mainnet | previewnet | localnode
HEDERA_NETWORK=testnet
# Optional overrides (defaults come from @sh/shared NETWORK_ENDPOINTS)
HEDERA_JSON_RPC_URL=
HEDERA_MIRROR_NODE_URL=

# --- Pyth ---
# Optional override of the known Hedera Pyth core address in PYTH_DEPLOYMENTS
PYTH_ORACLE_ADDRESS=
# Default feed: Crypto.HBAR/USD
NEXT_PUBLIC_ORACLE_FEED_ID=

# --- Registry & HCS ---
# Set after yarn hardhat:deploy (also written under .deploy/)
NEXT_PUBLIC_REGISTRY_ADDRESS=
NEXT_PUBLIC_REGISTRY_CONTRACT_ID=
# HCS topic that holds canonical attestation envelopes (0.0.x)
HEDERA_ATTESTATION_TOPIC_ID=

# --- Policy (optional; contract defaults apply if unset) ---
# 90 days — see packages/shared/src/constants/oracle.ts for why this is wide on Hedera today
REGISTRY_MAX_PRICE_AGE_SECONDS=
# 50 bps = 0.5%
REGISTRY_MAX_DEVIATION_BPS=

# --- Wallets (public) ---
# Used by Reown AppKit + native Hedera WalletConnect (packages/nextjs/lib/reown.ts)
NEXT_PUBLIC_REOWN_PROJECT_ID=
# Surfaced via /api/config allowlist; prefer NEXT_PUBLIC_REOWN_PROJECT_ID for wallet init
NEXT_PUBLIC_WALLET_CONNECT_PROJECT_ID=

# --- Optional AppKit metadata ---
NEXT_PUBLIC_APP_NAME=
NEXT_PUBLIC_APP_DESCRIPTION=
NEXT_PUBLIC_APP_URL=
