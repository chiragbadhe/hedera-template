{
  "name": "@sh/nextjs",
  "version": "0.1.0",
  "private": true,
  "description": "Priced Asset Registry front end: issue an HTS token, stamp it with a Pyth observation, attest over HCS, verify on Mirror Node.",
  "license": "MIT",
  "scripts": {
    "build": "next build",
    "check-types": "tsc --noEmit",
    "dev": "next dev",
    "format": "prettier --write \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.ts\" \"services/**/*.ts\" \"utils/**/*.ts\" \"types/**/*.ts\" \"*.{ts,mjs}\"",
    "format:check": "prettier --check \"app/**/*.{ts,tsx,css}\" \"components/**/*.{ts,tsx}\" \"hooks/**/*.ts\" \"services/**/*.ts\" \"utils/**/*.ts\" \"types/**/*.ts\" \"*.{ts,mjs}\"",
    "lint": "eslint .",
    "serve": "next start",
    "start": "next dev",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "dependencies": {
    "@hashgraph/hedera-wallet-connect": "2.1.3",
    "@heroicons/react": "2.2.0",
    "@hiero-ledger/proto": "^2.31.0",
    "@hiero-ledger/sdk": "2.89.1",
    "@hookform/resolvers": "5.9.1",
    "@reown/appkit": "^1.8.24",
    "@reown/appkit-adapter-wagmi": "^1.8.24",
    "@reown/walletkit": "^1.6.0",
    "@tanstack/react-query": "^5.104.1",
    "@walletconnect/modal": "^2.7.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "framer-motion": "12.23.24",
    "lucide-react": "0.548.0",
    "next": "15.5.7",
    "qrcode.react": "4.2.0",
    "react": "19.2.0",
    "react-dom": "19.2.0",
    "react-hook-form": "7.66.1",
    "server-only": "^0.0.1",
    "tailwind-merge": "3.4.1",
    "viem": "2.57.2",
    "wagmi": "^3.7.7",
    "zustand": "5.0.9"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@sh/shared": "0.1.0",
    "@tailwindcss/postcss": "4.1.16",
    "@types/node": "22.20.5",
    "@types/react": "19.2.2",
    "@types/react-dom": "19.2.1",
    "@vitejs/plugin-react": "5.1.0",
    "eslint": "9.39.5",
    "eslint-config-next": "15.5.9",
    "eslint-config-prettier": "10.1.5",
    "globals": "17.13.0",
    "jsdom": "27.0.1",
    "prettier": "3.9.9",
    "prettier-plugin-tailwindcss": "0.7.1",
    "tailwindcss": "4.1.16",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0",
    "vitest": "3.2.7"
  }
}
