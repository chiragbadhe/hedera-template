{
  "name": "@sh/hardhat",
  "version": "0.1.0",
  "private": true,
  "description": "PricedAssetRegistry Solidity contracts, deployment scripts and Hardhat tests.",
  "license": "MIT",
  "scripts": {
    "account:generate": "hardhat run scripts/generateAccount.ts",
    "account:import": "hardhat run scripts/importAccount.ts",
    "check-types": "tsc --noEmit",
    "clean": "hardhat clean",
    "compile": "hardhat compile",
    "deploy": "hardhat run scripts/deployRegistry.ts --network hederaTestnet",
    "deploy:local": "hardhat run scripts/deployRegistry.ts --network hardhat",
    "deploy:mainnet": "hardhat run scripts/deployRegistry.ts --network hederaMainnet",
    "flatten": "hardhat flatten",
    "format": "prettier --write \"contracts/**/*.sol\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "format:check": "prettier --check \"contracts/**/*.sol\" \"scripts/**/*.ts\" \"test/**/*.ts\"",
    "generate:abis": "hardhat run scripts/generateTsAbis.ts --network hardhat",
    "lint": "eslint .",
    "oracle:read": "hardhat run scripts/readOraclePrice.ts",
    "read:registry": "hardhat run scripts/readRegistry.ts",
    "test": "hardhat test",
    "verify:registry": "hardhat run scripts/verifyRegistry.ts --network hederaTestnet"
  },
  "dependencies": {
    "dotenv": "16.4.7",
    "ethers": "6.17.0"
  },
  "devDependencies": {
    "@eslint/js": "9.39.5",
    "@nomicfoundation/hardhat-chai-matchers": "2.0.8",
    "@nomicfoundation/hardhat-ethers": "3.1.3",
    "@sh/shared": "0.1.0",
    "@typechain/ethers-v6": "0.5.1",
    "@typechain/hardhat": "9.1.0",
    "@types/chai": "4.3.20",
    "@types/mocha": "10.0.10",
    "@types/node": "22.20.5",
    "chai": "4.5.0",
    "eslint": "9.39.5",
    "eslint-config-prettier": "10.1.5",
    "globals": "17.13.0",
    "hardhat": "2.29.1",
    "prettier": "3.9.9",
    "prettier-plugin-solidity": "2.4.1",
    "rimraf": "6.1.3",
    "ts-node": "10.9.2",
    "typechain": "8.3.2",
    "typescript": "5.9.3",
    "typescript-eslint": "8.71.0"
  }
}
